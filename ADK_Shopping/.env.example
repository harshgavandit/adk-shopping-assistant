OPENAI_API_KEY=replace-with-your-openai-key
LLM_MODEL=gpt-4o-mini
# Local Redis uses a dedicated port to avoid other projects' databases.
# For hosted Redis: rediss://username:password@hostname:port/0
REDIS_URL=redis://127.0.0.1:6381/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
LLM_RATE_LIMIT_REQUESTS=120
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CALLS=12
# Hosted public demo only: total chat submissions across visitors per 24-hour window.
PUBLIC_DAILY_CHAT_LIMIT=300
